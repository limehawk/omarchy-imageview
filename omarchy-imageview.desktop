[Desktop Entry]
Name=Image Viewer
Comment=Omarchy image viewer and browser
Exec=omarchy-imageview %F
Icon=image-x-generic
Terminal=false
Type=Application
Categories=Graphics;Viewer;
MimeType=image/jpeg;image/png;image/webp;image/gif;image/bmp;image/tiff;image/avif;image/heic;image/heif;image/svg+xml;image/x-canon-cr2;image/x-nikon-nef;image/x-sony-arw;image/x-adobe-dng;
StartupNotify=true
